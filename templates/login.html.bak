<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · Solvestreak</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('solvestreak-theme');
                if (saved) {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (e) {}
        })();
    </script>
    <style>
        .login-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: var(--bg);
            padding: 1.5rem;
        }
        .login-card {
            width: 100%;
            max-width: 380px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 2.25rem 2rem;
            text-align: center;
        }
        .login-brand {
            font-family: "Edwardian Script ITC", "Mrs Saint Delafield", cursive;
            font-size: 2.3rem;
            color: var(--accent);
            display: block;
            margin-bottom: 0.25rem;
        }
        :root[data-theme="dark"] .login-brand {
            color: #7a5fa6;
        }
        .login-tagline {
            color: var(--muted);
            font-size: 0.9rem;
            margin: 0 0 1.75rem;
        }
        .google-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            width: 100%;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }
        .google-btn:hover {
            background: var(--hover-surface);
        }
        .login-note {
            margin-top: 1.5rem;
            font-size: 0.78rem;
            color: var(--muted);
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <span class="login-brand">Solvestreak</span>
            <p class="login-tagline">Sign in to pick up right where you left off.</p>

            <a class="google-btn" href="{{ url_for('auth.google_login') }}">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.6-6 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.6 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4c-7.4 0-13.8 4.2-17 10.3z"/>
                    <path fill="#4CAF50" d="M24 44c5.5 0 10.4-1.9 14.3-5.1l-6.6-5.6c-2 1.5-4.7 2.5-7.7 2.5-5.3 0-9.8-3.5-11.3-8.3l-6.6 5.1C9.8 39.5 16.3 44 24 44z"/>
                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4.2 5.6l6.6 5.6C40.9 36.6 44 31 44 24c0-1.3-.1-2.7-.4-3.5z"/>
                </svg>
                Sign in with Google
            </a>

            <p class="login-note">Your session stays signed in on this device until you sign out — no need to log in again each time you open the app.</p>
        </div>
    </div>
</body>
</html>
